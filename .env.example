# Copy to .env and use secure values on the university server.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=rms.university.local,server-ip-address
DJANGO_CSRF_TRUSTED_ORIGINS=https://rms.university.local
DJANGO_API_TOKEN_TTL_SECONDS=3600

# PostgreSQL is recommended for any shared deployment.
DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=it_centre_rms
DJANGO_DB_USER=it_centre_rms
DJANGO_DB_PASSWORD=replace-with-a-database-password
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
DJANGO_DB_CONN_MAX_AGE=60

# Redis keeps rate limiting and cached access policy consistent across workers.
DJANGO_REDIS_URL=redis://127.0.0.1:6379/0

# Password resets use the free administrator-approval workflow by default.
# For optional email resets in the future, follow docs/optional-email-password-reset.md,
# uncomment these settings, and set DJANGO_PASSWORD_RESET_METHOD=email.
# DJANGO_EMAIL_HOST=smtp.university.local
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=rms@university.local
# DJANGO_EMAIL_HOST_PASSWORD=replace-with-an-smtp-password
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_DEFAULT_FROM_EMAIL=rms@university.local

# Enable only when HTTPS is active at the reverse proxy.
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_USE_X_FORWARDED_PROTO=True
DJANGO_USE_X_FORWARDED_HOST=True

# Optional storage locations outside the application checkout.
# DJANGO_STATIC_ROOT=/srv/it-centre-rms/staticfiles
# DJANGO_MEDIA_ROOT=/srv/it-centre-rms/media
